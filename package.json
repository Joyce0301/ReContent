    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.33",
